---
interface Props {
  links: { label: string; url: string }[];
}
const { links } = Astro.props;
---

<div class="friends">
  <h2>I AM ALWAYS ONLINE</h2>
  {links.map(({ label, url }) => (
    <div><a href={url || '#'}>&lt;{label}&gt;</a></div>
  ))}
</div>

<style>
  .friends {
    padding: 24px;
    background: #000;
    color: #fff;
    width: 200px;
    margin-top: 12px;
  }

  .friends h2 {
    font-size: 12px;
    letter-spacing: 2px;
    margin: 0 0 12px;
    padding: 0 0 6px;
    border-top: none;
    border-bottom: 2px dotted #fff;
  }

  .friends a {
    display: inline-block;
    color: #fff;
    text-decoration: none;
    padding: 3px;
  }

  .friends a:hover {
    text-decoration: underline;
  }
</style>
