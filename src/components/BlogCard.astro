---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;

const date = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const snippet = post.body
  .replace(/^---[\s\S]*?---/, '')
  .replace(/[#*_`>[\]()]/g, '')
  .replace(/\n+/g, ' ')
  .trim()
  .slice(0, 120)
  .replace(/\s\S+$/, '…');
---

<a href={`/blog/${post.slug}`} class="card">
  <h1>{post.data.header}</h1>
  <p class="meta">{date} — {post.data.tagline}</p>
  <p class="snippet">{snippet}</p>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    margin-bottom: 16px;
    border: 1px solid #000;
    padding: 8px;
    background: #fff;
  }

  .card:hover {
    background-image: url('/1.png');
  }

  .card h1 {
    margin-top: 0;
  }

  .meta {
    margin: 4px 0;
    font-style: italic;
  }

  .snippet {
    margin: 4px 0 0;
  }
</style>
