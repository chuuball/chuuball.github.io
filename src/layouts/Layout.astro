---
import { getEntry } from 'astro:content';
import Nav from '../components/Nav.astro';
import Marquee from '../components/Marquee.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Profile from '../components/Profile.astro';
import '../styles/global.css';

const siteEntry = await getEntry('site', 'site');
const sidebarEntry = await getEntry('sidebar', 'sidebar');
const site = siteEntry!.data;
const sidebar = sidebarEntry!.data;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{site.title}</title>
</head>
<body>
  <div class="outer">

    <div class="row-top">
      <div class="title">
        <div class="site-title">{site.title}</div>
        <div class="site-subtitle">{site.subtitle}</div>
      </div>
      <div class="banner-wrapper">
        <div
          class="banner"
          style={site.banner ? `background-image: url('${site.banner}')` : ''}
        ></div>
        <Marquee phrases={site.marquee} />
      </div>
    </div>

    <div class="row-bottom">
      <div class="left">
        <Nav />
        <SocialLinks links={site.socialLinks} />
        <div class="small">
          <small>kiiiiiiiiiiiimiiiiiiii daaaaaa keeeeeeeeee woooooooooooooooooooooooooooooooooo kimiiiiiiiiiiiii daaaaaaaakewooooooooooooooooooooooo suuuuuuuuukiiiiiiiiiideeeeeeeeeeeeeeeeeeeeeee iiiiiiiiitaaaaaaaaaayoooooooooooooooooooooooooooooooooo</small>
        </div>
      </div>
      <main class="main">
        <slot />
      </main>
      <Profile
        avatar={sidebar.avatar}
        bio={sidebar.bio}
        likes={sidebar.likes}
      />
    </div>

  </div>
</body>
</html>

<style>
  .outer {
    width: 900px;
    border: 1px solid #000;
    padding: 6px;
    background-image: url('/1.png');
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .row-top {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .row-bottom {
    display: flex;
    align-items: flex-start;
  }

  .title {
    border: 1px solid #000;
    width: 300px;
    height: 200px;
    flex-shrink: 0;
    background-image: url('/2.png');
  }

  .site-title {
    font-family: 'Gloria Hallelujah', sans-serif;
    font-size: 30px;
    text-align: center;
    padding-top: 50px;
  }

  .site-subtitle {
    text-align: center;
  }

  .banner-wrapper {
    width: 540px;
    flex-shrink: 0;
  }

  .banner {
    border: 1px solid #000;
    width: 100%;
    height: 170px;
    background-size: cover;
    background-position: 20%;
  }

  .left {
    width: 200px;
    flex-shrink: 0;
  }

  .main {
    border: 1px solid #000;
    flex: 1;
    height: 490px;
    background: #fff;
    overflow-y: auto;
    padding: 6px;
  }
</style>
